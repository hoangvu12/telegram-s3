LISTEN_ADDR=:9000
DATABASE_PATH=telegram-s3.db
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key
# Comma-separated list of bot tokens. New uploads round-robin across
# them and each chunk's bot_index is persisted so reads resolve through
# the same bot. Each bot authenticates its own MTProto session via
# auth.importBotAuthorization.
TELEGRAM_BOT_TOKENS=123456:your-bot-token-1,234567:your-bot-token-2
TELEGRAM_CHAT_ID=-1001234567890

# MTProto app credentials (register at https://my.telegram.org). Required.
TELEGRAM_APP_ID=
TELEGRAM_APP_HASH=

# MTProto tuning (optional). Defaults shown.
# TELEGRAM_POOL_SIZE=4             # gotd pool.Pool size per bot (session multiplexing)
# TELEGRAM_UPLOAD_THREADS=8        # uploader.WithThreads per upload

# HTTP / SQLite tuning (optional). Defaults shown.
# HTTP_MAX_IDLE_CONNS_PER_HOST=32  # keepalive pool for any HTTP-using paths (MTProto does not use)
# SQLITE_READER_CONNS=8            # reader pool size; writer is always single-conn (WAL)

# Cache + chunk-size knobs (optional). Defaults shown.
# LOCATION_CACHE_TTL=30m           # TTL for MTProto file-location cache entries
# TELEGRAM_MAX_CHUNK_SIZE=18MiB    # upload chunk window

# Parallel-prefetch reader (optional). Defaults shown.
# STREAM_CONCURRENCY=4             # in-flight chunk fetches per GET
# STREAM_BUFFERS=8                 # ordered delivery channel capacity
# CHUNK_TIMEOUT=30s                # per-chunk fetch deadline
# STREAM_CHUNK_SIZE=4MiB           # prefetch window; halves automatically for tiny Range requests
