LISTEN_ADDR=:9000
DATABASE_PATH=telegram-s3.db
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key
# Phase 3: comma-separated list of bot tokens. New uploads round-robin
# across them and each chunk's bot_index is persisted so reads resolve
# through the same bot (Bot API file_id is bot-bound). Put the legacy
# token first so backfilled rows (bot_index=0) keep resolving.
TELEGRAM_BOT_TOKENS=123456:your-bot-token-1,234567:your-bot-token-2
TELEGRAM_CHAT_ID=-1001234567890

# Optional: the pre-Phase-3 single token. Preserved as a rollback target
# (revert the binary + restore this value); also acts as the soft fallback
# when TELEGRAM_BOT_TOKENS is unset, so a partial deploy still boots.
# TELEGRAM_BOT_TOKEN=123456:your-bot-token

# Phase 0 throughput tuning (optional). Defaults shown.
# HTTP_MAX_IDLE_CONNS_PER_HOST=32  # keepalive pool for Telegram fan-out (Go default is 2)
# SQLITE_READER_CONNS=8            # reader pool size; writer is always single-conn (WAL)

# Phase 1 — Bot API path cache + chunk-size knob (optional). Defaults shown.
# LOCATION_CACHE_TTL=30m           # TTL for (file_id -> file_path) entries; invalidated on file-GET 404
# TELEGRAM_MAX_CHUNK_SIZE=18MiB    # upload chunk window; raise to ~1.9GiB when running a local tdlib/telegram-bot-api server

# Phase 2 — parallel-prefetch reader (optional). Defaults shown.
# STREAM_CONCURRENCY=4             # in-flight chunk fetches per GET
# STREAM_BUFFERS=8                 # ordered delivery channel capacity
# CHUNK_TIMEOUT=30s                # per-chunk fetch deadline
# STREAM_CHUNK_SIZE=4MiB           # prefetch window; halves automatically for tiny Range requests
